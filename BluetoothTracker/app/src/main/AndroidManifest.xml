<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth: Android 11 이하 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Bluetooth: Android 12 이상 (연결 이벤트 수신 + 기기 이름 조회) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 연결/해제 순간의 위치 기록 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 앱이 꺼져 있을 때(백그라운드)도 위치를 얻기 위해 필요 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <application
        android:name=".TrackerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BluetoothTracker"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          ACL_CONNECTED / ACL_DISCONNECTED 는 Android 8.0+ 암시적 브로드캐스트 제한의
          예외 목록에 포함되어 있어 매니페스트 등록만으로 앱이 꺼져 있어도 수신된다.
        -->
        <receiver
            android:name=".tracking.BluetoothEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
